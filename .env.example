# Data backend: "supabase" (hosted Postgres, requires the two NEXT_PUBLIC vars
# and applied migrations) or "local" (file-backed demo/dev mode, no Supabase
# needed). Defaults to supabase when NEXT_PUBLIC_SUPABASE_URL is set.
BONSAI_DATA_BACKEND=local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Python vision service (identity matching + leaf species index). Optional —
# capture degrades gracefully when unset or unreachable.
VISION_SERVICE_URL=http://localhost:8001

# Claude powers species/style suggestions and the Design Studio. Optional.
ANTHROPIC_API_KEY=

# Photoreal target-state renders: "gemini" (needs GEMINI_API_KEY), "mock"
# (returns the source photo — dev only), or "none".
BONSAI_IMAGE_PROVIDER=none
GEMINI_API_KEY=

# Photo serving in supabase mode: unset (default) redirects to short-lived signed
# Storage URLs so the CDN serves the bytes; "stream" proxies them through the app.
# Ignored in local mode, which always streams from disk.
BONSAI_PHOTO_SERVING=

# --- scripts only, never needed by the app container ---
# service_role key: bypasses RLS. Used by scripts/migrate-photos-to-storage.mjs
# and scripts/backup-storage-bucket.mjs.
SUPABASE_SERVICE_ROLE_KEY=
# Stage B gate: scripts/benchmark-voyage-reid.mjs
VOYAGE_API_KEY=
# Scratch database for scripts/restore-drill.mjs (the drill WIPES it).
RESTORE_TARGET_DB_URL=
